              pdfaSchema:schema="XMP Paged-Text">
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="XMP08 Spec: An ordered array of plate names that are needed to print the document (including any in contained documents)."
                  pdfaProperty:name="PlateNames"
                  pdfaProperty:valueType="Seq Text"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="A structure containing the characteristics of a font used in a document"
                  pdfaProperty:name="Fonts"
                  pdfaProperty:valueType="Bag Font"/>
              </rdf:Seq>
            </pdfaSchema:property>
            <pdfaSchema:valueType>
              <rdf:Seq>
                <rdf:li
                  pdfaType:description="A structure containing the characteristics of a font used in a document."
                  pdfaType:namespaceURI="http://ns.adobe.com/xap/1.0/sType/Font#"
                  pdfaType:prefix="stFnt"
                  pdfaType:type="Font"/>
              </rdf:Seq>
            </pdfaSchema:valueType>
            </rdf:Description>
          </rdf:li>
          <rdf:li>
            <rdf:Description
              pdfaSchema:namespaceURI="http://ns.adobe.com/pdfx/1.3/"
              pdfaSchema:prefix="pdfx"
              pdfaSchema:schema="pdfx">
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="ID of PDF/X standard"
                  pdfaProperty:name="GTS_PDFXVersion"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="Conformance level of PDF/X standard"
                  pdfaProperty:name="GTS_PDFXConformance"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="Company creating the PDF"
                  pdfaProperty:name="Company"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="Date when document was last modified"
                  pdfaProperty:name="SourceModified"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="external"
                  pdfaProperty:description="Mirrors crossmark:CrosMarkDomains"
                  pdfaProperty:name="CrossMarkDomains"
                  pdfaProperty:valueType="Seq Text"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="Mirrors crossmark:DOI"
                  pdfaProperty:name="doi"
                  pdfaProperty:valueType="Text"/>
              </rdf:Seq>
            </pdfaSchema:property>
            </rdf:Description>
          </rdf:li>
          <rdf:li>
            <rdf:Description
              pdfaSchema:namespaceURI="http://www.aiim.org/pdfa/ns/id/"
              pdfaSchema:prefix="pdfaid"
              pdfaSchema:schema="PDF/A ID Schema">
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="Part of PDF/A standard"
                  pdfaProperty:name="part"
                  pdfaProperty:valueType="Integer"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="Amendment of PDF/A standard"
                  pdfaProperty:name="amd"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="Conformance level of PDF/A standard"
                  pdfaProperty:name="conformance"
                  pdfaProperty:valueType="Text"/>
              </rdf:Seq>
            </pdfaSchema:property>
            </rdf:Description>
          </rdf:li>
          <rdf:li>
            <rdf:Description
              pdfaSchema:namespaceURI="http://crossref.org/crossmark/1.0/"
              pdfaSchema:prefix="crossmark"
              pdfaSchema:schema="crossmark">
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="CrossMarkDomains"
                  pdfaProperty:name="CrossMarkDomains"
                  pdfaProperty:valueType="Seq Text"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="CrossmarkDomainExclusive"
                  pdfaProperty:name="CrossmarkDomainExclusive"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="internal"
                  pdfaProperty:description="Usual same as prism:doi"
                  pdfaProperty:name="DOI"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="external"
                  pdfaProperty:description="The date when a publication was published."
                  pdfaProperty:name="MajorVersionDate"
                  pdfaProperty:valueType="Text"/>
              </rdf:Seq>
            </pdfaSchema:property>
            </rdf:Description>
          </rdf:li>
          <rdf:li>
            <rdf:Description
              pdfaSchema:namespaceURI="http://prismstandard.org/namespaces/basic/2.0/"
              pdfaSchema:prefix="prism"
              pdfaSchema:schema="Prism">
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li
                  pdfaProperty:category="external"
                  pdfaProperty:description="The aggregation type specifies the unit of aggregation for a content collection. &#xA;Comment &#xA;PRISM recommends that the PRISM Aggregation Type Controlled Vocabulary be used to provide values for this element. &#xA;Note: PRISM recommends against the use of the #other value currently allowed in this controlled vocabulary. In lieu of using #other please reach out to the PRISM group at info@prismstandard.org to request addition of your term to the Aggregation Type Controlled Vocabulary. &#xA;&#xA;"
                  pdfaProperty:name="aggregationType"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="external"
                  pdfaProperty:description="Copyright "
                  pdfaProperty:name="copyright"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="external"
                  pdfaProperty:description="The Digital Object Identifier for the article.&#xA;The DOI may also be used as the dc:identifier. If used as a dc:identifier, the URI form should be captured, and the bare identifier should also be captured using prism:doi. If an alternate unique identifier is used as the required dc:identifier, then the DOI should be specified as a bare identifier within prism:doi only. &#xA;If the URL associated with a DOI is to be specified, then prism:url may be used in conjunction with prism:doi in order to provide the service endpoint (i.e. the URL). &#xA;"
                  pdfaProperty:name="doi"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="external"
                  pdfaProperty:description="ISSN for an electronic version of the issue in which the resource occurs. &#xA;Permits publishers to include a second ISSN, identifying an electronic version of the issue in which the resource occurs (therefore e(lectronic)Issn. If used, prism:eIssn MUST contain the ISSN of the electronic version. See prism:issn. &#xA;"
                  pdfaProperty:name="issn"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="external"
                  pdfaProperty:description="Title of the magazine, or other publication, in which a resource was/will be published. &#xA;Typically this will be used to provide the name of the magazine an article appeared in as metadata for the article, along with information such as the article title, the publisher, volume, number, and cover date. &#xA;&#xA;Note: Publication name can be used to differentiate between a print magazine and the online version if the names are different such as â€œmagazineâ€ and â€œmagazine.com.â€ &#xA;"
                  pdfaProperty:name="publicationName"
                  pdfaProperty:valueType="Text"/>
                <rdf:li
                  pdfaProperty:category="external"
                  pdfaProperty:description="This element provides the url for an article or unit of content. &#xA;The attribute platform is optionally allowed for situations in which multiple URLs must be specified. PRISM recommends that a subset of the PCV platform values, namely â€œmobileâ€ and â€œwebâ€, be used in conjunction with this element. &#xA;NOTE: PRISM recommends against the use of the #other value allowed in the PRISM Platform controlled vocabulary. In lieu of using #other please reach out to the PRISM group at prism-wg@yahoogroups.com to request addition of your term to the Platform Controlled Vocabulary. &#xA;"
                  pdfaProperty:name="url"
                  pdfaProperty:valueType="Text"/>
              </rdf:Seq>
            </pdfaSchema:property>
            </rdf:Description>
          </rdf:li>
          <rdf:li>
            <rdf:Description
              pdfaSchema:namespaceURI="http://springernature.com/ns/xmpExtensions/2.0/"
              pdfaSchema:prefix="sn"
              pdfaSchema:schema="Springer Nature ORCID Schema">
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li
                  pdfaProperty:category="external"
                  pdfaProperty:description="Author information: contains the name of each author and his/her ORCID (ORCiD: Open Researcher and Contributor ID). An ORCID is a persistent identifier (a non-proprietary alphanumeric code) to uniquely identify scientific and other academic authors."
                  pdfaProperty:name="authorInfo"
                  pdfaProperty:valueType="Bag AuthorInformation"/>
              </rdf:Seq>
            </pdfaSchema:property>
            <pdfaSchema:valueType>
              <rdf:Seq>
                <rdf:li>
                  <rdf:Description
                    pdfaType:description="Specifies the types of author information: name and ORCID of an author."
                    pdfaType:namespaceURI="http://springernature.com/ns/xmpExtensions/2.0/authorInfo/"
                    pdfaType:prefix="author"
                    pdfaType:type="AuthorInformation">
                  <pdfaType:field>
                    <rdf:Seq>
                      <rdf:li
                        pdfaField:description="Gives the name of an author."
                        pdfaField:name="name"
                        pdfaField:valueType="Text"/>
                      <rdf:li
                        pdfaField:description="Gives the ORCID of an author."
                        pdfaField:name="orcid"
                        pdfaField:valueType="URI"/>
                    </rdf:Seq>
                  </pdfaType:field>
                  </rdf:Description>
                </rdf:li>
              </rdf:Seq>
            </pdfaSchema:valueType>
            </rdf:Description>
          </rdf:li>
          <rdf:li>
            <rdf:Description
              pdfaSchema:namespaceURI="http://www.niso.org/schemas/jav/1.0/"
              pdfaSchema:prefix="jav"
              pdfaSchema:schema="NISO">
            <pdfaSchema:property>
              <rdf:Seq>
                <rdf:li
                  pdfaProperty:category="external"
                  pdfaProperty:description="Values for Journal Article Version are one of the following:&#xA;AO = Authorâ€™s Original&#xA;SMUR = Submitted Manuscript Under Review&#xA;AM = Accepted Manuscript&#xA;P = Proof&#xA;VoR = Version of Record&#xA;CVoR = Corrected Version of Record&#xA;EVoR = Enhanced Version of Record"
                  pdfaProperty:name="journal_article_version"
                  pdfaProperty:valueType="Closed Choice of Text"/>
              </rdf:Seq>
            </pdfaSchema:property>
            </rdf:Description>
          </rdf:li>
        </rdf:Bag>
      </pdfaExtension:schemas>
    </rdf:Description>
  </rdf:RDF>
</x:xmpmeta>
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                
