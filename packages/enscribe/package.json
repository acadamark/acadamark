{
  "name": "@enscribejs/enscribe",
  "version": "0.4.0",
  "description": "Academic publishing on HTML+CSS+JS, with a shorthand authoring syntax. The headline library: the Layer 1 core foundation, the shorthand parser (remark plugin), and the interpreter that compiles enscribeTag nodes to Layer 1 HTML.",
  "keywords": [
    "enscribe",
    "academic-publishing",
    "semantic-html",
    "layer1",
    "unified",
    "remark",
    "remark-plugin",
    "interpreter",
    "katex",
    "html"
  ],
  "homepage": "https://github.com/enscribejs/enscribe",
  "bugs": "https://github.com/enscribejs/enscribe/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enscribejs/enscribe.git",
    "directory": "packages/enscribe"
  },
  "license": "MIT",
  "author": "Ariel Balter <ariel@arielbalter.com>",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "browser": {
    "./src/interpreter/assets/hover-preview-assets.js": "./src/interpreter/assets/hover-preview-assets.browser.js"
  },
  "exports": {
    ".": "./src/interpreter/index.js",
    "./core/*": "./src/core/*.js",
    "./interpreter/lib/section-kinds": "./src/interpreter/lib/section-kinds.js",
    "./interpreter/lib/book-regions": "./src/interpreter/lib/book-regions.js",
    "./parser": "./src/parser/index.js",
    "./parser/*": "./src/parser/*.js",
    "./browser": "./dist/enscribe.browser.js",
    "./browser-global": "./dist/enscribe.browser.global.js",
    "./default.css": "./src/interpreter/assets/default.css",
    "./shell/*": "./src/shell/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:grammar": "node build/compile-grammar.js",
    "pretest": "node build/compile-grammar.js",
    "test": "node test/colon-id.test.js && node test/tagname-sigil-map.test.js && node test/unquoted-value.test.js && node test/test-grammar.js && node test/test.js && node test/test-recursive.js && node test/run.js",
    "verify": "node test/colon-id.test.js && node test/tagname-sigil-map.test.js && node test/unquoted-value.test.js && node test/test-grammar.js && node test/test.js && node test/test-recursive.js && node test/run.js && node test/render-fixtures.js",
    "build:lib": "tsup",
    "build:lib:watch": "tsup --watch",
    "demo": "node test/demo.js"
  },
  "dependencies": {
    "@enscribejs/layer1-vocabulary": "^0.4.0",
    "@popperjs/core": "^2.11.8",
    "abcjs": "^6.6.3",
    "citation-js": "^0.7.22",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-html": "^9.0.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^25.0.1",
    "katex": "^0.16.45",
    "mdast-util-to-hast": "^13.0.0",
    "mermaid": "^10.9.6",
    "rehype-format": "^5.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tippy.js": "^6.3.7",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "peggy": "^4.2.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
