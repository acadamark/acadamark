{
  "name": "@enscribejs/remark",
  "version": "0.1.0",
  "description": "Remark plugin for the enscribe shorthand syntax. Hybrid architecture: micromark finds construct boundaries, Peggy parses grammar semantics.",
  "keywords": [
    "remark",
    "remark-plugin",
    "unified",
    "micromark",
    "markdown",
    "enscribe",
    "academic-publishing"
  ],
  "homepage": "https://github.com/enscribejs/enscribe",
  "bugs": "https://github.com/enscribejs/enscribe/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enscribejs/enscribe.git",
    "directory": "packages/remark-enscribe"
  },
  "license": "MIT",
  "author": "Ariel Balter <ariel@arielbalter.com>",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./recursive-content": "./src/recursive-content.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:grammar": "node build/compile-grammar.js",
    "pretest": "node build/compile-grammar.js",
    "test": "node test/test-grammar.js && node test/test.js",
    "demo": "node test/demo.js"
  },
  "dependencies": {
    "@enscribejs/core": "^0.1.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "peggy": "^4.2.0"
  }
}
