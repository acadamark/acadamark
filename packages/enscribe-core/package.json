{
  "name": "@enscribejs/core",
  "version": "0.1.0",
  "description": "The inward-pointing shared foundation that enscribe's parser, interpreter, and future output generators depend on. Filesystem-free and browser-safe by design. Depends on nothing internal.",
  "keywords": [
    "enscribe",
    "academic-publishing",
    "semantic-html",
    "layer1",
    "unified",
    "core"
  ],
  "homepage": "https://github.com/enscribejs/enscribe",
  "bugs": "https://github.com/enscribejs/enscribe/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enscribejs/enscribe.git",
    "directory": "packages/enscribe-core"
  },
  "license": "MIT",
  "author": "Ariel Balter <ariel@arielbalter.com>",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./dsl-registry": "./src/dsl-registry.js",
    "./structured-elements": "./src/structured-elements.js",
    "./frameable-elements": "./src/frameable-elements.js",
    "./map-attributes": "./src/map-attributes.js",
    "./tagname-sigil-map": "./src/tagname-sigil-map.js",
    "./tag": "./src/tag.js",
    "./error-nodes": "./src/error-nodes.js",
    "./registry": "./src/registry.js",
    "./walkers/discover": "./src/walkers/discover.js",
    "./walkers/walk-replace": "./src/walkers/walk-replace.js",
    "./walkers/walk-normalize": "./src/walkers/walk-normalize.js",
    "./colon-id": "./src/colon-id.js",
    "./paragraph-unwrap": "./src/paragraph-unwrap.js",
    "./file-data-keys": "./src/file-data-keys.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/colon-id.test.js && node test/tagname-sigil-map.test.js"
  }
}
